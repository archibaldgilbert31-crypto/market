# Строка без кавычек. Пароль и имя пользователя — как в PostgreSQL (при установке задаётся пароль суперпользователя).
# Если в пароле есть @ # : / и т.п., закодируйте пароль (например в браузере: encodeURIComponent).
DATABASE_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/marketplace?schema=public

# Обязательно: случайная строка (например openssl rand -hex 32). Без него сервер не стартует.
JWT_SECRET=

PORT=3001

# Публичный URL API для ссылок на загруженные файлы (товары). В проде: https://ваш-backend.up.railway.app
# Если не задано, берётся из заголовков запроса (локально обычно http://localhost:3001).
# API_PUBLIC_URL=

# Через запятую (без пробелов): каждый origin = схема + хост без пути, например https://xxx.up.railway.app
# Обязательно добавьте сюда публичный URL веб-кабинета продавца, если он на отдельном домене (иначе браузер заблокирует /api Preflight по CORS).
# Пример: https://market.apps.com,https://powerful-balance-production-4616.up.railway.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5180

# После npm run db:migrate:deploy выполните npm run db:seed — в БД попадут магазины, товары и демо-пользователи:
#   Админ:    admin@marketplace.ru / admin123
#   Покупатели: buyer1@marketplace.demo … buyer3@marketplace.demo / Buyer123!
#   Продавцы: owner-seller-N@marketplace.demo / Seller123! (каждый привязан к своему магазину seller-N)
